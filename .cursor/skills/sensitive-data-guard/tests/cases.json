{
  "version": 1,
  "description": "Automated test case definitions for sensitive-data-guard. Fixture paths are relative to tests/fixtures/.",
  "cases": [
    {
      "id": "clean-normal",
      "name": "A normal technical doc should pass",
      "fixture": "01-clean-normal.txt",
      "whitelist": [],
      "no_whitelist": true,
      "expect_exit": 0,
      "expect_rules": [],
      "min_findings": 0,
      "max_findings": 0
    },
    {
      "id": "block-password",
      "name": "A password assignment should be blocked",
      "fixture": "02-block-password.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["password_assignment"],
      "min_findings": 1
    },
    {
      "id": "block-aksk",
      "name": "AK/SK and cloud keys should be blocked",
      "fixture": "03-block-aksk.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": [
        "aws_access_key_id",
        "aws_secret_access_key",
        "generic_ak_sk_pair",
        "aliyun_ak"
      ],
      "min_findings": 4
    },
    {
      "id": "block-pii",
      "name": "Personally identifiable information should be blocked",
      "fixture": "04-block-pii.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": [
        "member_name_field",
        "marriott_bonvoy_id",
        "cn_mobile_phone",
        "email_address",
        "cn_id_card",
        "passport_field",
        "passport_no",
        "address_field",
        "cn_address_text",
        "bank_card"
      ],
      "min_findings": 6
    },
    {
      "id": "block-tokens",
      "name": "Various tokens should be blocked",
      "fixture": "05-block-tokens.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": [
        "token_assignment",
        "github_token",
        "bearer_token",
        "jwt",
        "slack_token"
      ],
      "min_findings": 4
    },
    {
      "id": "whitelist-placeholders",
      "name": "Placeholders and sample values should pass after applying the default whitelist",
      "fixture": "06-whitelist-placeholders.txt",
      "whitelist": ["default"],
      "expect_exit": 0,
      "expect_rules": [],
      "max_findings": 0
    },
    {
      "id": "block-partial-whitelist",
      "name": "Mixed content: placeholders pass, real sensitive values are still blocked",
      "fixture": "07-block-partial-whitelist.txt",
      "whitelist": ["default"],
      "expect_exit": 2,
      "expect_rules": [
        "aws_access_key_id",
        "password_assignment",
        "member_name_field",
        "email_address"
      ],
      "min_findings": 3
    },
    {
      "id": "block-private-key",
      "name": "A PEM private key block should be blocked",
      "fixture": "08-block-private-key.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["private_key_block"],
      "min_findings": 1
    },
    {
      "id": "stdin-text",
      "name": "--text mode should block an inline sensitive string",
      "inline_text": "api_token: sk_test_abcdefghijklmnopqrstuvwxyz",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["token_assignment"],
      "min_findings": 1
    },
    {
      "id": "bank-card-luhn-valid",
      "name": "A bank card number that passes the Luhn check should be blocked",
      "inline_text": "test card 4111 1111 1111 1111",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["bank_card"],
      "min_findings": 1
    },
    {
      "id": "bank-card-luhn-invalid",
      "name": "A 16-digit number that fails the Luhn check should not match bank_card",
      "inline_text": "order id 4111 1111 1111 1112",
      "no_whitelist": true,
      "expect_exit": 0,
      "forbid_rules": ["bank_card"],
      "max_findings": 0
    },
    {
      "id": "passport-standalone",
      "name": "A passport number (letter+digits) should be blocked without a keyword",
      "inline_text": "his travel doc is E12345678 issued in 2020",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["passport_no"],
      "min_findings": 1
    },
    {
      "id": "passport-intl-formats",
      "name": "Common international passport formats should be blocked without a keyword",
      "inline_text": "UK passport 923456789, German C01X00T47, India L6892603, Japan TR1234567",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["passport_no"],
      "min_findings": 2
    },
    {
      "id": "passport-field-keyword",
      "name": "A passport field assignment (incl. all-digit) should be blocked",
      "inline_text": "passport: 123456789",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["passport_field"],
      "min_findings": 1
    },
    {
      "id": "passport-field-multilang",
      "name": "A non-English passport keyword should be blocked",
      "inline_text": "여권번호: M12345678",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["passport_field"],
      "min_findings": 1
    },
    {
      "id": "passport-no-false-positive",
      "name": "A normal product code should not match passport_no",
      "inline_text": "build artifact ROADMAP2024 shipped",
      "no_whitelist": true,
      "expect_exit": 0,
      "forbid_rules": ["passport_no"],
      "max_findings": 0
    },
    {
      "id": "bonvoy-id-keyword",
      "name": "A Marriott Bonvoy member number should be blocked",
      "inline_text": "Bonvoy member number: 123456789",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["marriott_bonvoy_id"],
      "min_findings": 1
    },
    {
      "id": "bonvoy-id-chinese",
      "name": "A Chinese 万豪旅享家 member number should be blocked",
      "inline_text": "会员号码：987654321",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["marriott_bonvoy_id"],
      "min_findings": 1
    },
    {
      "id": "bonvoy-id-false-positive",
      "name": "A plain 9-digit number without a member keyword should not match marriott_bonvoy_id",
      "inline_text": "order id 123456789 processed at remember 987654321",
      "no_whitelist": true,
      "expect_exit": 0,
      "forbid_rules": ["marriott_bonvoy_id"],
      "max_findings": 0
    }
  ]
}
