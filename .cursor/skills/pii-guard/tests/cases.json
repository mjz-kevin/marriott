{
  "version": 1,
  "description": "pii-guard 自动化测试用例定义。fixture 路径相对于 tests/fixtures/。",
  "cases": [
    {
      "id": "clean-normal",
      "name": "普通技术文档应通过",
      "fixture": "01-clean-normal.txt",
      "whitelist": [],
      "no_whitelist": true,
      "expect_exit": 0,
      "expect_rules": [],
      "min_findings": 0,
      "max_findings": 0
    },
    {
      "id": "block-password",
      "name": "密码赋值应被拦截",
      "fixture": "02-block-password.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["password_assignment"],
      "min_findings": 1
    },
    {
      "id": "block-aksk",
      "name": "AK/SK 与云密钥应被拦截",
      "fixture": "03-block-aksk.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": [
        "aws_access_key_id",
        "aws_secret_access_key",
        "generic_ak_sk_pair",
        "aliyun_ak"
      ],
      "min_findings": 4
    },
    {
      "id": "block-pii",
      "name": "个人敏感信息应被拦截",
      "fixture": "04-block-pii.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": [
        "member_name_field",
        "cn_mobile_phone",
        "email_address",
        "cn_id_card",
        "address_field",
        "cn_address_text",
        "bank_card"
      ],
      "min_findings": 6
    },
    {
      "id": "block-tokens",
      "name": "各类 token 应被拦截",
      "fixture": "05-block-tokens.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": [
        "token_assignment",
        "github_token",
        "bearer_token",
        "jwt",
        "slack_token"
      ],
      "min_findings": 4
    },
    {
      "id": "whitelist-placeholders",
      "name": "占位符与示例值套用 default 白名单后应通过",
      "fixture": "06-whitelist-placeholders.txt",
      "whitelist": ["default"],
      "expect_exit": 0,
      "expect_rules": [],
      "max_findings": 0
    },
    {
      "id": "block-partial-whitelist",
      "name": "混合内容:占位符放行、真实敏感值仍拦截",
      "fixture": "07-block-partial-whitelist.txt",
      "whitelist": ["default"],
      "expect_exit": 2,
      "expect_rules": [
        "aws_access_key_id",
        "password_assignment",
        "member_name_field",
        "email_address"
      ],
      "min_findings": 3
    },
    {
      "id": "block-private-key",
      "name": "PEM 私钥块应被拦截",
      "fixture": "08-block-private-key.txt",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["private_key_block"],
      "min_findings": 1
    },
    {
      "id": "stdin-text",
      "name": "--text 模式应能拦截内联敏感字符串",
      "inline_text": "api_token: sk_test_abcdefghijklmnopqrstuvwxyz",
      "no_whitelist": true,
      "expect_exit": 2,
      "expect_rules": ["token_assignment"],
      "min_findings": 1
    }
  ]
}
